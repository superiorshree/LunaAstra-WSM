{
  "name": "lunastra-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "LunaAstra Lunar Habitat AI Decision Support System — Electron + React Frontend",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^32.0.1",
    "electron-builder": "^25.0.5",
    "vite": "^5.4.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.lunastra.wsm",
    "productName": "LunaAstra",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
