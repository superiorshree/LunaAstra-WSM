# LunaAstra Backend — Environment Variables
# Copy this file to .env and fill in your actual keys
# Never commit .env to version control

# ─── AI ───────────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ─── NASA ─────────────────────────────────────────────────────────────────────
# Get a free key at: https://api.nasa.gov
NASA_API_KEY=DEMO_KEY

# ─── Data Mode ────────────────────────────────────────────────────────────────
# Set to "true" to use mock NumPy data (Phase 1)
# Set to "false" to read real GeoTIFFs from backend/data/raw/
USE_MOCK_DATA=true

# ─── Mock Grid Size ───────────────────────────────────────────────────────────
MOCK_GRID_ROWS=100
MOCK_GRID_COLS=100

# ─── Space Weather Polling ────────────────────────────────────────────────────
# How often to poll NASA DONKI (seconds). Default 300 = 5 minutes
DONKI_POLL_INTERVAL=300
